<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ProfilePage">

    <TextView
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/muh_raihannn"
        android:textStyle="bold"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="20dp"
        android:layout_marginLeft="20dp"
        />

    <ImageView
        android:id="@+id/menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/menu"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginRight="20dp"
        android:layout_marginTop="20dp"
        />

    <ImageView
        android:id="@+id/add"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/add"
        app:layout_constraintEnd_toStartOf="@id/menu"
        app:layout_constraintTop_toTopOf="@id/menu"
        app:layout_constraintBottom_toBottomOf="@id/menu"
        android:layout_marginEnd="10dp"
        />

    <ImageView
        android:id="@+id/arrowdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/arrowdown"
        app:layout_constraintStart_toEndOf="@id/name"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="20dp"
        android:layout_marginStart="5dp"
        />

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/iv_profile"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:src="@drawable/image3"
        app:layout_constraintTop_toBottomOf="@id/name"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        />

    <TextView
        android:id="@+id/nickname"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/hanzz"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/name"
        app:layout_constraintStart_toEndOf="@id/iv_profile"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"
        />

    <TextView
        android:id="@+id/postCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="7"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/nickname"
        app:layout_constraintStart_toEndOf="@id/iv_profile"
        android:layout_marginStart="20dp"
        />

    <TextView
        android:id="@+id/postLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="posts"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/postCount"
        app:layout_constraintStart_toEndOf="@id/iv_profile"
        android:layout_marginStart="20dp"
        />

    <TextView
        android:id="@+id/followersCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="700"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/nickname"
        app:layout_constraintStart_toEndOf="@id/postCount"
        android:layout_marginStart="50dp"
        />

    <TextView
        android:id="@+id/followersLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="followers"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/postCount"
        app:layout_constraintStart_toEndOf="@id/postLabel"
        android:layout_marginStart="20dp"
        />

    <TextView
        android:id="@+id/followingCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="536"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/nickname"
        app:layout_constraintStart_toEndOf="@id/followersCount"
        android:layout_marginStart="50dp"
        />

    <TextView
        android:id="@+id/followingLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="following"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/followingCount"
        app:layout_constraintStart_toEndOf="@id/followersLabel"
        android:layout_marginStart="20dp"
        />

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Digital Creator"
        android:textColor="#838383"
        app:layout_constraintTop_toBottomOf="@id/iv_profile"
        app:layout_constraintStart_toStartOf="@id/iv_profile"
        android:layout_marginTop="10dp"
        />

    <TextView
        android:id="@+id/bio1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="☄️☄️☄️"
        android:textColor="#000000"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintStart_toStartOf="@id/iv_profile"
        />

    <TextView
        android:id="@+id/bio2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Trying to be better"
        android:textColor="#000000"
        app:layout_constraintTop_toBottomOf="@id/bio1"
        app:layout_constraintStart_toStartOf="@id/iv_profile"
        />



    <com.google.android.material.button.MaterialButton
        android:id="@+id/editProfile"
        android:layout_width="190dp"
        android:layout_height="wrap_content"
        android:text="Edit profile"
        app:layout_constraintTop_toBottomOf="@id/bio2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/shareProfile"
        android:textColor="@color/black"
        app:cornerRadius="6dp"
        app:backgroundTint="#E6E6E6"
        android:layout_marginTop="15dp"
        />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/shareProfile"
        android:layout_width="190dp"
        android:layout_height="wrap_content"
        android:text="Share profile"
        app:layout_constraintTop_toBottomOf="@id/bio2"
        app:layout_constraintStart_toEndOf="@id/editProfile"
        app:layout_constraintEnd_toEndOf="parent"
        android:textColor="@color/black"
        app:cornerRadius="6dp"
        app:backgroundTint="#E6E6E6"
        android:layout_marginTop="15dp"

        />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_highlightStory"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/highlight_story"
        app:spanCount="3"
        tools:itemCount="8"
        app:layout_constraintTop_toBottomOf="@id/editProfile"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="10dp"
        android:layout_marginStart="10dp"
        android:orientation="horizontal"

        />


    <ImageView
        android:id="@+id/gridView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/gridview"
        app:layout_constraintTop_toBottomOf="@id/rv_highlightStory"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/video"
        android:layout_marginTop="20dp"
        />

    <ImageView
        android:id="@+id/video"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/video"
        app:layout_constraintTop_toBottomOf="@id/rv_highlightStory"
        app:layout_constraintStart_toEndOf="@id/gridView"
        app:layout_constraintEnd_toStartOf="@id/profile"
        android:layout_marginTop="20dp"
        />

    <ImageView
        android:id="@+id/profile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/profile"
        app:layout_constraintTop_toBottomOf="@id/rv_highlightStory"
        app:layout_constraintStart_toEndOf="@id/video"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp"
        />




    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_profileFeeds"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        tools:listitem="@layout/profile_feed_layout"
        app:spanCount="3"
        tools:itemCount="9"
        app:layout_constraintTop_toBottomOf="@id/gridView"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="10dp"
        />

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:background="@color/white"
        android:padding="8dp"
        android:weightSum="3"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Home Icon -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/homeIcon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/home"
                android:contentDescription="Home"
                android:scaleType="centerInside" />
        </LinearLayout>

        <!-- Add Icon -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/AddPostIcon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/add"
                android:contentDescription="Add"
                android:scaleType="centerInside"

                />
        </LinearLayout>

        <!-- Profile Icon -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/profileIcon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/image3"
                android:scaleType="centerCrop" />
        </LinearLayout>
    </LinearLayout>




</androidx.constraintlayout.widget.ConstraintLayout>