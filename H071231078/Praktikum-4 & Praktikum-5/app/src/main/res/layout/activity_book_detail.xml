<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="@color/white"
    tools:context=".BookDetailActivity">

    <ImageView
        android:id="@+id/iv_cover"
        android:layout_width="200dp"
        android:layout_height="300dp"
        android:layout_marginBottom="16dp"
        android:scaleType="centerCrop"
        android:elevation="8dp"
        android:background="@drawable/image_background_rounded"
        android:contentDescription="Book Cover"
        android:src="@drawable/atomichabbit"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_judul"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Judul Buku"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        app:layout_constraintTop_toBottomOf="@id/iv_cover"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_penulis"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Penulis Buku"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/tv_judul"
        app:layout_constraintStart_toStartOf="parent"
        />

    <TextView
        android:id="@+id/tv_tahunTerbit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tahun Terbit"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/tv_judul"
        app:layout_constraintStart_toEndOf="@id/tv_penulis"
        app:layout_constraintTop_toTopOf="@id/tv_penulis"
        app:layout_constraintBottom_toBottomOf="@id/tv_penulis"/>


    <TextView
        android:id="@+id/tv_rating"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Rating"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/tv_tahunTerbit"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_genre"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Genre: Self Improvement"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/tv_rating"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_blurb"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Blurb buku atau deskripsi singkat..."
        android:textSize="14sp"
        android:paddingTop="8dp"
        android:lineSpacingExtra="4dp"
        app:layout_constraintTop_toBottomOf="@id/tv_genre"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_review_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Review"
        android:textSize="14sp"
        android:lineSpacingExtra="4dp"
        android:textStyle="bold"
        android:paddingTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tv_blurb"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_review"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Review pengguna..."
        android:textSize="14sp"
        android:lineSpacingExtra="4dp"
        android:paddingTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tv_review_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/likeButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/black"
        android:textColor="@android:color/white"
        android:text="Like"
        app:icon="@drawable/likeblack"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:cornerRadius="16dp"
        app:layout_constraintTop_toBottomOf="@id/tv_review"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
